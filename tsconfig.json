{
    "compilerOptions": {
        "target":                       "es2022",
        "module":                       "nodenext",
        "moduleResolution":             "nodenext",
        "lib":                          [ "es2022" ],
        "types":                        [ "node" ],
        "rootDir":                      ".",
        "outDir":                       "dst",
        "strict":                       true,
        "esModuleInterop":              true,
        "skipLibCheck":                 true,
        "forceConsistentCasingInFileNames": true
    },
    "files": [
        "vcs.ts"
    ]
}

